<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ChinaCNU Steel - Coil Calculator</title>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');
        
        :root {
            --primary-color: #1663b2;
            --accent-color: #4a90e2;
            --dark-color: #1a3e72;
            --light-color: #edf4fd;
            --white: #ffffff;
            --gray: #f5f7fa;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Inter', sans-serif;
            background-color: var(--gray);
            color: #1e293b;
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 1rem;
        }

        .container {
            max-width: 100%;
            max-width: 560px;
            background: var(--white);
            border-radius: 16px;
            border: 1px solid #e2e8f0;
            padding: 2.5rem;
            box-shadow: 0 8px 24px rgba(0, 77, 155, 0.08);
            position: relative;
            overflow: hidden;
        }

        .language-toggle {
            position: absolute;
            right: 1rem;
            top: 17px;
        }

        .logo-branding {
            text-align: center;
            margin: 15px 0 2rem 0;
            color: var(--primary-color);
            font-size: 1rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .logo {
            width: 0.8em;
            height: 0.8em;
            display: inline-block;
            margin: -0.5em 5px 0 5px;
        }

        button, input {
            display: block;
            width: 100%;
            padding: 0.5rem 1.5rem;
            font-size: 0.92rem;
            background: linear-gradient(to right, var(--primary-color), var(--accent-color));
            color: white;
            font-weight: 600;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            transition: all 0.3s;
            box-shadow: 0 8px 20px rgba(var(--primary-color), 0.15);
            margin: 20px 0;
        }

        .form-group {
            margin: 1rem 0;
        }

        .form-group label {
            display: block;
            font-size: 0.85rem;
            margin-bottom: 0.5px;
            color: var(--dark-color);
        }

        .input-field {
            display: block;
            width: 100%;
            border: 1px solid #ddd;
            padding: 12px 16px;
            border-radius: 6px;
            font-size: 1rem;
            margin-top: 0;
            transition: all 0.2s ease-in-out;
        }

        input:focus {
            border-color: 2px solid var(--accent-color);
            outline: none;
            box-shadow: 0 5px 5px rgba(0, 136, 255, 0.3);
        }

        .result-section {
            margin-top: 1.5rem;
            background: var(--light-color);
            padding: 1.5rem;
            border-radius: 8px;
            border: 1px solid #e8f4ff;
            color: var(--primary-color);
        }

        .result-title {
            font-weight: 600;
            margin-bottom: 0.8px;
            font-size: 1rem;
        }

        .formula-area {
            display: none;
        }

        .formula-section .formula {
            font-family: Consolas, "Courier New", monospace;
            padding: 7px;
            border-radius: 10px;
            background-color: #f0f0f0;
        }
    </style>
</head>

<body>
    <div class="container">
        <button class="language-toggle" role="button" aria-label="Toggle language">
            <svg viewBox="0 0 24 24" width="20" height="20">
                <path fill="currentColor" d=""></path>
            </svg>
        </button>
        <div class="logo-branding">
            <svg class="logo" viewBox="0 0 48 48" width="48" height="48">
                <circle cx="24" cy="24" r="20" fill="var(--primary-color)"/>
                <text x="24" y="32" text-anchor="middle" font-size="18" fill="#fff" font-family="Inter, sans-serif" font-weight="700">CNU</text>
            </svg>
        </div>

        <h1>
            <div class="l10n active" data-lang="en">
                <h1>Coated Coil Calculator</h1>
                <p>Calculate weight & length</p>
            </div>
            <div class="l10n" data-lang="zh">
                <h1>彩涂钢卷计算</h1>
                <p>重量、每吨米数及面积计算</p>
            </div>
        </h1>

        <form id="Calculator">
            <div class="form-group">
                <div class="labels label-group">
                    <label class="l10n active" data-lang="en">Thickness (mm)</label>
                    <label class="l10n" data-lang="zh">厚度(mm)</label>
                </div>
                <input type="number" id="thickness" min="0.1" step="0.01" value="0.6" required>
            </div>

            <div class="form-group">
                <div class="labels label-group">
                    <label class="l10n active" data-lang="en">Width (mm)</label>
                    <label class="l10n" data-lang="zh">宽度(mm)</label>
                </div>
                <input type="number" id="width" min="0.1" step="0.01" value="600" required>
            </div>

            <button id="calculate" onclick="calculate()">Calculate</button>

            <div class="result-section" id="result"></div>

            <div class="formula-area" style="display:none">
                <strong class="title">Calculation Formula</strong>
                <div class="formula en">
                    <span>Meters = 1000 × thickness (m) × width (m) × 7850</span>
                </div>
                <div class="formula zh">
                    <span>米数 = 1000 ÷ (厚度(m) × 宽度(m) × 7850)</span>
                </div>
            </div>
        </form>
    </div>

    <script>
        const calculate = () => {
            const thickness = parseFloat(document.getElementById("thickness").value) / 1000; // to m
            const width = parseFloat(document.getElementById("width").value) / 1000; // to m

            if (isNaN(thickness) || isNaN(width)) {
                document.getElementById("result").innerHTML = '请输入有效的数字。';
                return;
            }

            const metersPerTon = 1000 / (thickness * width * 7850);
            const kgPerTon = metersPerTon * width;
            const weightPerMeter = thickness * width * 7850;

            document.getElementById("result").innerHTML = `
                ${LANGUAGES.current === 'zh' ? `
                    <div class="result-title">计算结果</div>
                    <p><strong>${weightPerMeter.toFixed(2)} kg/m</strong></p>
                    <p>每吨米重量: ${weightPerMeter.toFixed(2)} kg</p>
                    <p>每吨米数: ${metersPerTon.toFixed(2)} 米</p>
                    <p>每吨面积: ${(width.toFixed(2))} m²</p>
                ` : `
                    <div class="result-title">Results</div>
                    <p><strong>${weightPerMeter.toFixed(2)} kg/m</strong></p>
                    <p>Meters per ton: ${metersPerTon.toFixed(2)} m</p>
                    <p>Area per ton: ${width.toFixed(2)} m</p>
                `}
            `;
        };

        const LANGUAGES = {
            current: 'zh'
        }

        function toggleLanguage() {
            LANGUAGES.current = LANGUAGES.current === 'zh' ? 'en' : 'zh';
            document.querySelectorAll('.l10n').forEach(element => {
                element.classList.toggle('active', element.getAttribute('data-lang') === LANGUAGES.current);
            });
        }

        document.querySelector('.language-toggle').addEventListener('click', toggleLanguage);

        // Initialize
        window.onload = function() {
            document.getElementById('thickness').value = 0.6;
            document.getElementById('width').value = 600;
            calculate();
        }
    </script>
</body>
</html>
